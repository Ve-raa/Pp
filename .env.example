# ─── VÉRA Mobile App — Environment Variables ──────────────────────────────────
# Copy this file to .env before running the app locally.
# NEVER commit .env to git.

# Base URL for the VÉRA API
EXPO_PUBLIC_API_URL=https://veraapp.app

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Use pk_test_* for development/testing.
# Replace with your pk_live_* key before submitting to App Store / Play Store.
EXPO_PUBLIC_STRIPE_KEY=pk_test_51TnyPtJ6f3war2oRv26PCoUhyeN0OespUi7ukamDyncVXjUdL33QDqPoHpPAhkQlPbSWtnQWIM1NNkXTyJimArkO00MlxNl46j

# ─── Tabby (BNPL) ─────────────────────────────────────────────────────────────
# Get your public key from https://dashboard.tabby.ai
# Required to show Tabby as a payment option at checkout.
# EXPO_PUBLIC_TABBY_KEY=your-tabby-public-key-here

# ─── Tamara (BNPL) ────────────────────────────────────────────────────────────
# Tamara integration is handled server-side; no public key needed in the app.
# Ensure TAMARA_SANDBOX=false is set in the backend .env for production.
